  "unit_of_analysis": "object (unit) means over all evaluated frames; CIs = 2000x bootstrap clustered by video",
  "arms": {
    "B1": "P5 baseline (M5.5): full-res prompt memory; reference for every comparison",
    "A1": "virtual camera: square crop side s = max(box_h, box_w)/0.25 of the prompt box, clamped to >= min(H,W)/4; no crop (== B1) if s >= min(H,W). Centre = box centre of the previous OUTPUT mask (prompt GT at t=1); kept if empty. Crop shifted inside the frame. SAM 2 sees only crops (one scale), output pasted back.",
    "A2": "global-local: A1 crop state and B1 full-frame state run independently (no memory exchange). Frame t output = crop mask if crop obj score > 0, crop mask non-empty and not touching an interior crop edge; else the B1 mask. Next crop centre = box centre of this fused output (kept if empty)."
  },
  "A2_trigger": "run A2 only if A1 shows >= 3 small units with dJF >= +0.03 (opportunity) or >= 3 small units with dJF <= -0.03 (context loss / escape)",
  "gate_A": {
    "set": "small units of DAVIS_val + PUMaVOS_B (vs B1)",
    "pass_all": [
      "mean small-unit dJF >= +0.03",
      "fraction of small units with dJF < -0.01 below 20%",
      "mean non-small-unit dJF >= -0.005 (DAVIS_val + PUMaVOS_B)"
    ],
    "secondary_not_gating": "PUMaVOS_A, SegTrack, video-clustered CI, episodes, latency"
  },
  "track_B": {
    "event": "reappearance: GT visible (area >= 25% of the unit's median visible area) at frame t after >= 1 frame that is GT-empty or below 25% of median; eligible frames = t..t+4",
    "absence_type": "out_of_frame if the last visible GT box before absence is within 2 px of the frame border, else occluded; annotation-defined absence flagged by visual check (guitar in M5.6)",
    "online_opportunity": "existing SAM 2 output: best of the 3 multimask candidates J >= 0.5 while output J < 0.5 (needs a selector); first-frame appearance: M5.6 I1 history reset resolves",
    "B3_trigger": ">= 4 non-annotation reappearance events in >= 3 videos where B1 J < 0.5 on the first eligible frame AND an online opportunity exists; else Track B is underpowered and no prototype is built",
    "B3_gate": "if built: mean J over eligible frames +0.10 on triggering events, >= 3 videos improved, no unit whole-sequence dJF < -0.01, overall mean dJF >= 0"
  },
  "track_C": {
    "diagnostic": "RETROSPECTIVE upper bound: SAM 2 image mode with GT box (+inner point), best of 3, on every 5th GT-visible frame of small units, full frame vs square crop of the A1 side centred on the GT box; also the 256 ceiling at both scales",
    "rule": "input scale is a fixable bottleneck if crop oracle - full oracle >= +0.05 mean and positive in >= 60% of small units; decoder-output bottleneck if 256-ceiling J < 0.8 on >= 25% of small-unit frames",
    "C3": "assessment only, no training in M6"
  },
