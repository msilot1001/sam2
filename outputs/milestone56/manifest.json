  },
  "fail_J": 0.5,
  "merge_gap": 2,
  "max_episodes_per_unit": 3,
  "window": 10,
  "recover_rule": {
    "min_mean_J": 0.5,
    "min_gain": 0.15
  },
  "class_rules": [
    [
      "E_occlusion_absence",
      "GT area at onset < 25% of the unit's median visible GT area, or GT empty"
    ],
    [
      "F_identity_distractor",
      ">= 30% of predicted pixels on another annotated object, or predicted area > 2x GT with < 50% of GT covered (capture of something else)"
    ],
    [
      "A_spatial_resolution",
      "256 ceiling J at onset < 0.5 (GT -> official low-res logits -> video res)"
    ],
    [
      "BC_static_segmentation",
      "image oracle J (GT box / box+inner point, best of 3) < 0.5"
    ],
    [
      "D_memory_propagation",
      "image oracle >= 0.5 and >= video J + 0.2"
    ],
    [
      "H_unresolved",
      "anything else"
    ]
  ],
  "interventions": {
    "I0_native": "B1 continuation (control)",
    "I1_history_reset": "exclude every non-prompt memory (spatial + pointer) older than t0; memories formed at >= t0 allowed",
    "I2_older_backfill": "exclude memories of frames t0-6..t0-1, refill spatial slots from older frames (L=32) [M5-Pre A4]",
    "I3_gt_reprompt": "RETROSPECTIVE: GT mask at t0 added as a conditioning frame (full-res memory); not deployable",
    "I4_multimask_oracle": "RETROSPECTIVE: best of SAM 2's 3 candidate masks at t0 (observational; no state change)"
  },
  "diagnosed_sets": [
    "DAVIS val (M5.5 exploration set)",
    "PUMaVOS A",
    "PUMaVOS B"
  ],
  "scale_probe": "RETROSPECTIVE fixed GT-union crop (10% margin) re-run of whole clip for units with episodes whose median GT area < 1% of frame"
